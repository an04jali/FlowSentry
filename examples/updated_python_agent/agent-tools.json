      "input_schema": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string"
          },
          "include_invoices": {
            "type": "boolean"
          }
        },
        "required": ["customer_id", "include_invoices"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
