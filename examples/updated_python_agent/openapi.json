{
  "openapi": "3.0.0",
  "info": {
    "title": "Example Agent API",
    "version": "2.0.0"
  },
  "paths": {
    "/tickets/{ticket_id}": {
      "get": {
        "operationId": "get_ticket",
        "summary": "Get a support ticket with priority.",
        "parameters": [
          {
            "name": "ticket_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include_history",
            "in": "query",
            "required": true,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ticket response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "priority": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
